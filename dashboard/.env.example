# Copy to .env.local. The dashboard holds NO model/GitHub keys — those live in the harness.

# TrueForge API (for the live run adapter; the demo/replay mode needs none).
TRUEFORGE_API_URL=http://localhost:8790

# attesta-mcp — the ledger the console reads, and the MCP endpoint for verify_ledger.
# Local dev reads the ledger file directly:
ATTESTA_LEDGER_PATH=../attesta-mcp/data/ledger.jsonl
ATTESTA_MCP_URL=http://127.0.0.1:8130/mcp
# Split deploy (dashboard on Vercel, attesta-mcp on Render): read entries over HTTP instead of the
# file. When set, ATTESTA_LEDGER_URL takes precedence over ATTESTA_LEDGER_PATH. See DEPLOY.md.
#   ATTESTA_LEDGER_URL=https://attesta-mcp-xxxx.onrender.com/ledger
#   ATTESTA_MCP_URL=https://attesta-mcp-xxxx.onrender.com/mcp

# Demo-only: enable the Tamper/Restore buttons. They are refused (HTTP 403) unless BOTH this is "1"
# AND ATTESTA_LEDGER_PATH names a *demo* ledger (basename contains "demo"), so a runtime request can
# never mutate canonical evidence. Leave unset in any real deployment.
#   ATTESTA_DEMO=1
#   ATTESTA_LEDGER_PATH=../attesta-mcp/data/demo-ledger.jsonl
