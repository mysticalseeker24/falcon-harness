# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
secrets/
.daytona/
.trueforge/

# Node
node_modules/
dist/
build/
.next/
out/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TrueForge local mode data
*.sqlite
db.sqlite

# attesta-mcp local ledger + artifact store (runtime data)
attesta-mcp/data/

# bench: keep the committed result artifact (latest.json), never the internal error log
attesta-mcp/bench-results/bench-error.log

# seed: transient swap dirs from `npm run seed` (the committed seed/ is what ships)
attesta-mcp/seed.tmp/
attesta-mcp/seed.bak/

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Python (if attesta-mcp is Python)
__pycache__/
*.pyc
.venv/
venv/
.ruff_cache/

# Test / coverage
coverage/
.pytest_cache/
