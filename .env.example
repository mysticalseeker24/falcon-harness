# Copy to .env and fill in. NEVER commit .env.
# Secrets live in the harness / Render env in production; this file is for local dev only.

# --- Models (OpenRouter, one key for all three) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Sandbox ---
DAYTONA_API_KEY=

# --- GitHub (token scoped to DevLabs-mgc/vulnbank; used by GitHub MCP) ---
GITHUB_TOKEN=

# --- Storage ---
DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- attesta-mcp ---
ATTESTA_MCP_PORT=8130

# --- TrueForge (local mode) ---
# SQLITE_PATH=~/trueforge/db.sqlite
# PUBLIC_BASE_URL=

# --- Dashboard (Vercel) holds only this in production ---
TRUEFORGE_API_URL=
