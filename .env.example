# Copy to .env and fill in. NEVER commit .env.
# Secrets live in the harness / Render env in production; this file is for local dev only.

# --- Models (OpenRouter, one key for all three) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# seal_evidence audits on AUDITOR_MODEL, which MUST be a different provider family than WRITER_MODEL
# (the main agent). Enforced at audit time. Default: writer=DeepSeek, auditor=Z.ai GLM (cheap).
# Needs OPENROUTER_API_KEY in attesta-mcp's env.
AUDITOR_MODEL=z-ai/glm-5.3-flash
WRITER_MODEL=deepseek/deepseek-v4-pro-0813

# --- Sandbox ---
DAYTONA_API_KEY=

# --- GitHub (token scoped to DevLab-mgc/vulnbank; used by GitHub MCP) ---
GITHUB_TOKEN=

# --- Storage ---
DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- attesta-mcp ---
ATTESTA_MCP_PORT=8130
ATTESTA_MCP_HOST=127.0.0.1
# Local filesystem storage (default, tested). On Render the same paths point at a persistent disk
# (see render.yaml / DEPLOY.md); PORT + 0.0.0.0 binding are handled automatically there. The
# Postgres + R2 adapters (DATABASE_URL / R2_*) are a future swap, not the current deploy.
ATTESTA_LEDGER_PATH=./data/ledger.jsonl
ATTESTA_ARTIFACT_DIR=./data/artifacts
# On a fresh deploy the server seeds an empty ledger from attesta-mcp/seed/. Set to 0 to disable.
# ATTESTA_SEED_ON_BOOT=1
# Bearer token gating /mcp (the only mutation surface). Unset ⇒ /mcp open (loopback dev only). On a
# public deploy this MUST be set (Render auto-generates it); the agent/harness that seals sends it as
# Authorization: Bearer <token>. Reads (/ledger, /verify, /health) never need it.
# ATTESTA_MCP_TOKEN=

# --- TrueForge (local mode) ---
# SQLITE_PATH=~/trueforge/db.sqlite
# PUBLIC_BASE_URL=

# --- Dashboard (Vercel) holds only this in production ---
TRUEFORGE_API_URL=
